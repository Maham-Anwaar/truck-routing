# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Providers (default to keyless synthetic data) ---

# Routing: "synthetic" (default) | "ors"
ROUTING_PROVIDER=synthetic
# OpenRouteService key (free: https://openrouteservice.org) — required for ors.
ORS_API_KEY=

# Weather: "synthetic" (default) | "open_meteo"
# open_meteo is keyless for non-commercial use — no key needed.
# (The heatmap grid stays synthetic regardless; only /routes/plan checkpoints go real.)
WEATHER_PROVIDER=synthetic

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
