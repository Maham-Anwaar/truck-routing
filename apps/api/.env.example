# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Providers (default to keyless synthetic data) ---

# Routing: "ors" | "synthetic". Auto-uses ors when ORS_API_KEY is set,
# else synthetic (the only keyless real router needs self-hosting).
# ORS_API_KEY — free: https://openrouteservice.org
ORS_API_KEY=

# Weather: "open_meteo" (default, real, keyless) | "synthetic".
# (The heatmap grid is always synthetic — a per-cell real grid isn't feasible;
# only /routes/plan checkpoints use real weather.)
WEATHER_PROVIDER=open_meteo

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
