# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# OpenRouteService (routing) — free key from https://openrouteservice.org
ORS_API_KEY=

# Weather provider — TBD. NOAA/NWS (api.weather.gov) needs no key, just a
# descriptive User-Agent per their usage policy:
# NWS_USER_AGENT=truck-routing (you@example.com)

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
